+
+describe('summarizeScenes with short answers', () => {
+  const openQ = (id: string): QuizQuestion => ({
+    id,
+    type: 'short_answer',
+    question: id,
+    hasAnswer: false,
+    points: 20,
+  });
+  const stored = (questionId: string, correct: boolean | null): QuestionResult => ({
+    questionId,
+    correct,
+    status: correct ? 'correct' : 'incorrect',
+    earned: correct ? 20 : 0,
+  });
+  const questions = [
+    openQ('q1'),
+    choiceQ('q2', ['a']),
+    choiceQ('q3', ['b']),
+    openQ('q4'),
+    choiceQ('q5', ['b']),
+  ];
+  const answers = { q1: 'text', q2: 'a', q3: 'b', q4: 'text', q5: 'b' };
+  const all = (q1: boolean | null, q4: boolean | null) => [
+    stored('q1', q1),
+    stored('q2', true),
+    stored('q3', true),
+    stored('q4', q4),
+    stored('q5', true),
+  ];
+  const run = (results?: QuestionResult[], qs = questions) => {
+    const scene = quizScene('quiz', 0, qs);
+    const load = async () => ({ state: { phase: 'reviewed', answers, results } });
+    return summarizeScenes([scene], () => readSceneQuizAnswers(scene, load));
+  };
+
+  it('counts graded short answers like the quiz report', async () => {
+    const result = await run(all(true, true));
+    expect(result.quiz).toEqual({ correct: 5, total: 5, pct: 100 });
+    expect(result.firstWrongQuizId).toBeNull();
+  });
+
+  it('offers the review for a wrong short answer', async () => {
+    const result = await run(all(false, true));
+    expect(result.quiz).toEqual({ correct: 4, total: 5, pct: 80 });
+    expect(result.firstWrongQuizId).toBe('quiz');
+  });
+
+  it('counts a failed grading call as the report does', async () => {
+    const result = await run(all(null, true));
+    expect(result.quiz).toEqual({ correct: 4, total: 5, pct: 80 });
+    expect(result.firstWrongQuizId).toBe('quiz');
+  });
+
+  it('scores a quiz of short answers only', async () => {
+    const graded = [stored('q1', true), stored('q4', false)];
+    const result = await run(graded, [openQ('q1'), openQ('q4')]);
+    expect(result.quiz).toEqual({ correct: 1, total: 2, pct: 50 });
+  });
+
+  it('keeps the stored verdict when the answer key is edited later', async () => {
+    const edited = questions.map((q) => (q.id === 'q2' ? choiceQ('q2', ['b']) : q));
+    const result = await run(all(true, true), edited);
+    expect(result.quiz).toEqual({ correct: 5, total: 5, pct: 100 });
+  });
+
+  it('ignores the result of a deleted question', async () => {
+    const result = await run(all(false, true), questions.slice(1));
+    expect(result.quiz).toEqual({ correct: 4, total: 4, pct: 100 });
+  });
+
+  it('falls back to choice questions for attempts without stored results', async () => {
+    for (const results of [undefined, []]) {
+      const result = await run(results);
+      expect(result.quiz).toEqual({ correct: 3, total: 3, pct: 100 });
+    }
+  });
+});
